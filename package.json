{
  "name": "chatgpt-computer-plugin",
  "private": true,
  "version": "1.4.5",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build:web && tsx server/index.ts",
    "build:web": "node scripts/build-web.mjs && node scripts/check-workbench-bundle.mjs",
    "copy:web": "node scripts/copy-workbench-assets.mjs",
    "check:cross-repo-contract": "node scripts/check-cross-repo-browser-contract.mjs",
    "check:public-edge": "node scripts/check-public-edge.mjs",
    "check:host-release": "node scripts/check-host-release.mjs",
    "check:deployed-contract": "node scripts/check-deployed-contract.mjs",
    "check:release": "npm run typecheck && npm test && npm run build && npm run check:cross-repo-contract",
    "check:mcp-traffic-integration": "node scripts/check-mcp-traffic-integration.mjs",
    "check:mcp-traffic-acceptance": "node scripts/run-mcp-traffic-acceptance.mjs",
    "check:mcp-live-activity": "node scripts/check-mcp-live-activity-integration.mjs",
    "benchmark:mcp-latency": "tsx scripts/benchmark-mcp-latency.ts",
    "build": "npm run build:web && tsc -p tsconfig.json && npm run copy:web",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.10",
    "js-tiktoken": "^1.0.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
