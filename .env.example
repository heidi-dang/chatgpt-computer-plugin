CPTR_BASE_URL=http://127.0.0.1:8000
CPTR_API_TOKEN=replace-with-a-scoped-cptr-token
MCP_ACCESS_TOKEN=replace-with-a-private-bearer-token
PUBLIC_ORIGIN=https://mcp.tnaprovider.com.au
# Comma-separated, exact browser origins permitted to call MCP and Live Workbench endpoints.
MCP_ALLOWED_ORIGINS=https://chatgpt.com
NODE_ENV=production
MCP_OAUTH_RESOURCE=https://mcp.tnaprovider.com.au/mcp
CLOUDFLARE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-with-the-access-application-audience
CLOUDFLARE_ACCESS_JWKS_URI=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
MCP_OAUTH_ALLOWED_EMAIL=owner@example.com
MCP_OAUTH_SCOPES=
HOST=127.0.0.1
PORT=8787
